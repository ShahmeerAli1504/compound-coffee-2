# ------------------------------------------------------------------
# Gmail SMTP — copy this file to .env.local and fill it in.
# On Vercel: Project → Settings → Environment Variables (same names).
# ------------------------------------------------------------------

# The Gmail address that sends the emails (it must be the account the app password belongs to)
GMAIL_USER=thecompound.inc24@gmail.com

# A 16-character Gmail *App Password* — NOT the normal Gmail password.
# Google Account → Security → 2-Step Verification (turn on) → App passwords → create one.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where new inquiries are delivered (comma-separate for more than one inbox)
MAIL_TO=thecompound.inc24@gmail.com

# Name shown in the "From" field
MAIL_FROM_NAME=The Compound Coffee

# Send the customer a "we got it" confirmation email (true/false)
SEND_CONFIRMATION=true

# Public URL of the site (used for SEO + sitemap). Optional on Vercel —
# it falls back to the project's production domain automatically.
# NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
